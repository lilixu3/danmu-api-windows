<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ── 配置编辑器表单词汇 ────────────────────────────────────────────────
       排版与结构对齐核心自带前端（ui/css/forms.css.js）的尺寸与层级：
       字段标签 12px/600 灰、控件间距 5px、字段块下边距 14px、只读值用虚线框。
       颜色一律沿用本应用 token，不引入核心那套主题色。 -->

  <!-- 字段标签：12px、半粗、次要色、字距 0.02em -->
  <Style Selector="TextBlock.form-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="LetterSpacing" Value="0.2" />
  </Style>

  <!-- 只读值（变量类别 / 变量名 / 值类型 / 描述）：虚线边框 + 等宽可选文本。
       内边距比核心略紧（8,10 vs 10,12）：四个只读框叠起来很吃高度，弹窗会被撑太高。 -->
  <Style Selector="Border.readonly-field">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.readonly-field TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.readonly-field TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
  </Style>

  <!-- 字段块：标签 + 控件，下边距比核心的 14 略紧（10），四个只读框叠起来才不会太高 -->
  <Style Selector="StackPanel.form-field">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.form-help">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 弹窗头部：标题用强调色（核心 .modal-header h3 的口径），右侧圆形关闭 -->
  <Style Selector="TextBlock.dialog-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.dialog-close">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.dialog-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- 底部两个等宽按钮（核心是 flex:1 各占一半） -->
  <Style Selector="Button.dialog-action">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- 规则子表单面板：核心 .offset-rule-panel（圆角 12 / 内边距 16 / 面板底色） -->
  <Style Selector="Border.rule-panel">
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- ── 布尔开关（核心 .switch：48×26 胶囊 + 20px 圆钮） ── -->
  <Style Selector="StackPanel.switch-row">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.switch-track">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.switch-track.on">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Ellipse.switch-thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Fill" Value="White" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ── 数字滚轮（核心 .number-picker：面板底 + ▲▼ 竖排 + 大号数字） ── -->
  <Style Selector="Border.number-picker">
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TextBlock.number-display">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.number-step">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.number-step:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ── 单选 / 多选胶囊（核心 .tag-option / .available-tag） ── -->
  <Style Selector="Button.tag-pill">
    <Setter Property="Padding" Value="9,18" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="Button.tag-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>
  <Style Selector="Button.tag-pill.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.tag-pill.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.tag-pill:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- 多选容器：核心 .selected-tags（虚线框、min-height 60） -->
  <Style Selector="Border.tag-drop-zone">
    <Setter Property="MinHeight" Value="60" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- 已选胶囊：强调色实心 + 圆形删除（核心 .selected-tag / .remove-btn） -->
  <Style Selector="Border.tag-selected">
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>
  <Style Selector="Border.tag-selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tag-remove">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Background" Value="#4DFFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 暂存区（核心 .staging-area：虚线 + 强调底色 + 圆形确认钮） -->
  <Style Selector="Border.staging-zone">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.staging-confirm">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 来源快捷标签（核心 .offset-source-tag：5/14 内边距、圆角 20、12px） -->
  <Style Selector="Button.source-pill">
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}" />
  </Style>
  <Style Selector="Button.source-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.source-pill.selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.source-pill.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- 映射表一行（核心 .map-item） -->
  <Style Selector="Border.map-row">
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- 最近数据卡片（核心 .anime-cache-card） -->
  <Style Selector="Border.data-card">
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.data-panel">
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
</Styles>
