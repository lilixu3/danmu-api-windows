<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DanmuApi.App.Views.ConfigurationEditorWindow"
        MinWidth="520"
        MaxWidth="1080"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <!-- 结构对齐核心自带前端的 #env-modal（template.js:451-483）：头部（标题 + 圆形关闭）
       → 变量类别 → 变量名 → 值类型 → 动态控件区 → 描述 → 底部两个等宽按钮。
       与核心不同的是**头尾固定、只有中间滚动**：保存/取消始终可见，不必拉到底部。
       中间用 `*` 行：窗口被拉高时内容区跟着长，不会上下留白。 -->
  <Grid Margin="28" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <TextBlock x:Name="TitleBlock"
                   Classes="dialog-title"
                   Text="编辑配置项" />
        <Button x:Name="CloseButton"
                Grid.Column="1"
                Classes="dialog-close"
                Content="✕" />
      </Grid>
      <Border Height="1"
              Background="{DynamicResource HairlineBrush}"
              HorizontalAlignment="Stretch" />
    </StackPanel>

    <!-- 中间：唯一可滚动区域 -->
    <ScrollViewer x:Name="ContentScroll"
                  Grid.Row="1"
                  Margin="0,22,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel Classes="form-field">
          <TextBlock Classes="form-label" Text="变量类别" />
          <Border Classes="readonly-field">
            <TextBlock x:Name="CategoryBlock" />
          </Border>
        </StackPanel>

        <StackPanel Classes="form-field">
          <TextBlock Classes="form-label" Text="变量名" />
          <Border Classes="readonly-field">
            <TextBlock x:Name="KeyBlock" Classes="mono" />
          </Border>
        </StackPanel>

        <StackPanel Classes="form-field">
          <TextBlock Classes="form-label" Text="值类型" />
          <Border Classes="readonly-field">
            <TextBlock x:Name="TypeBlock" />
          </Border>
        </StackPanel>

        <!-- 动态控件区：编辑器自己渲染「变量值」这类字段块 -->
        <ContentControl x:Name="EditorHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        Margin="0,0,0,14" />

        <StackPanel Classes="form-field">
          <TextBlock Classes="form-label" Text="描述" />
          <Border Classes="readonly-field">
            <SelectableTextBlock x:Name="DescriptionBlock" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <TextBlock x:Name="ErrorBlock"
                   Classes="danger-text"
                   TextWrapping="Wrap"
                   IsVisible="False" />
      </StackPanel>
    </ScrollViewer>

    <!-- 底部：常驻可见，两个等宽按钮 -->
    <Grid Grid.Row="2"
          ColumnDefinitions="*,*"
          ColumnSpacing="10"
          Margin="0,18,0,0">
      <Button x:Name="SaveButton"
              Classes="primary dialog-action"
              Content="保存"
              IsDefault="True" />
      <Button x:Name="CancelButton"
              Grid.Column="1"
              Classes="secondary dialog-action"
              Content="取消"
              IsCancel="True" />
    </Grid>
  </Grid>
</Window>
