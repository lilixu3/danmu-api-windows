<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DanmuApi.App.Views.ConfigurationEditorWindow"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        MaxWidth="920"
        MaxHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24"
        MinWidth="472"
        MaxWidth="872"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">
    <StackPanel x:Name="HeaderPanel" Spacing="6">
      <TextBlock x:Name="TitleBlock"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="DescriptionBlock"
                 Classes="body-muted"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorBlock"
                 Classes="danger-text"
                 TextWrapping="Wrap"
                 IsVisible="False" />
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  MaxHeight="520"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="EditorHost"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Top" />
    </ScrollViewer>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <!-- 只保留取消/保存：清空与恢复默认都由配置列表行上的「清除」按钮负责，
           同一个动作不在两处出现，避免用户在两套语义之间做选择。 -->
      <Button x:Name="CancelButton"
              Classes="secondary-action"
              Content="取消"
              MinWidth="86"
              IsCancel="True" />
      <Button x:Name="SaveButton"
              Classes="primary-action"
              Content="保存"
              MinWidth="86"
              IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
