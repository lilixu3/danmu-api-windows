<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.FavoritesView"
             x:DataType="vm:FavoritesPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- 内容块用满内容列：不再带 MaxWidth（宽窗口下会被居中收窄、两侧留白）。 -->
    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
      <!-- 模式名由弹幕测试页签承担，这里只留一句说明。 -->
      <TextBlock Text="收藏会保存关键词对应的搜索结果快照；写入、刷新和删除遵守核心能力与管理员权限。" Classes="cap" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBox Classes="field" Text="{Binding SearchText, Mode=TwoWay}" Watermark="过滤收藏关键词（边输入边筛选）" />
        <Button Grid.Column="1" Content="添加收藏" Classes="primary" Command="{Binding AddCommand}" IsEnabled="{Binding CanWrite}" />
        <Button Grid.Column="2" Content="刷新列表" Classes="secondary" Command="{Binding LoadCommand}" />
      </Grid>
      <Border Classes="notice-panel" IsVisible="{Binding HasSupportMessage}">
        <TextBlock Text="{Binding Capabilities.SupportMessage}" Classes="cap" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding Diagnostic}" Classes="cap" TextWrapping="Wrap" IsVisible="{Binding HasDiagnostic}" />

      <!-- 每行收藏不再各自套一个描边小卡（长列表里叠一堆框很碎），
           统一放进一张卡、行间用 1px 分隔线，与下载页的列表一致。 -->
      <Border Classes="card" IsVisible="{Binding HasFavorites}">
        <ItemsControl ItemsSource="{Binding VisibleFavorites}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FavoriteItemViewModel">
              <Border Classes="rule">
                <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="12" Margin="0,9">
                  <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                          Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
                    <Grid Width="68" Height="92">
                      <Image Source="{Binding Poster}" IsVisible="{Binding HasPoster}" Stretch="UniformToFill" />
                      <Border IsVisible="{Binding ShowPosterPlaceholder}" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="{Binding PosterFallbackText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0"
                          Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding MetaLine}" Classes="cap" />
                      <TextBlock Text="{Binding CollectedText}" Classes="cap" />
                      <TextBlock Text="{Binding LastRefreshText}" Classes="cap" />
                      <TextBlock Text="{Binding ScheduleSummaryText}" Classes="cap" />
                      <TextBlock Text="{Binding ScheduleDetailText}" Classes="cap" IsVisible="{Binding HasSchedule}" />
                    </StackPanel>
                  </Button>
                  <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="240">
                    <Button Content="定时" Classes="secondary" Margin="0,0,6,0" MinWidth="68" IsVisible="{Binding !HasSchedule}" Command="{Binding $parent[ItemsControl].DataContext.ScheduleCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].DataContext.CanSchedule}" />
                    <Button Content="修改定时" Classes="secondary" Margin="0,0,6,0" MinWidth="76" IsVisible="{Binding HasSchedule}" Command="{Binding $parent[ItemsControl].DataContext.ScheduleCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].DataContext.CanSchedule}" />
                    <Button Content="关闭定时" Classes="ghost" Margin="0,0,6,0" MinWidth="76" IsVisible="{Binding HasSchedule}" Command="{Binding $parent[ItemsControl].DataContext.DisableScheduleCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].DataContext.CanSchedule}" />
                    <Button Content="刷新" Classes="secondary" Margin="0,0,6,0" MinWidth="68" Command="{Binding $parent[ItemsControl].DataContext.RefreshCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].DataContext.CanWrite}" />
                    <Button Content="删除" Classes="danger" MinWidth="68" Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].DataContext.CanWrite}" />
                  </WrapPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Border Classes="card" IsVisible="{Binding !HasFavorites}">
        <TextBlock Text="暂无收藏；在手动匹配中搜索后可收藏当前关键词的整组结果。" Classes="cap" HorizontalAlignment="Center" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
