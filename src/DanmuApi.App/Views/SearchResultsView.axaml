<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.SearchResultsView"
             x:DataType="vm:SearchResultsPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <Button Content="返回手动匹配" Classes="secondary" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="搜索结果" Classes="section" />
          <TextBlock Text="{Binding Keyword, StringFormat='关键词：{0}'}" Classes="cap" />
          <TextBlock Text="{Binding FavoriteCapabilityText}" Classes="cap" TextWrapping="Wrap" />
        </StackPanel>
        <Button x:Name="FavoriteSnapshotButton" Grid.Column="1"
                Content="{Binding FavoriteActionText}"
                Classes="secondary"
                Command="{Binding ToggleFavoriteCommand}"
                IsEnabled="{Binding CanToggleFavorite}"
                VerticalAlignment="Center" />
      </Grid>
      <Border Classes="notice-panel" IsVisible="{Binding HasDiagnostic}">
        <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" />
      </Border>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchResultRowViewModel">
            <Button Classes="entity-card" Width="140" Margin="0,0,10,10"
                    Command="{Binding $parent[ItemsControl].DataContext.SelectAnimeCommand}" CommandParameter="{Binding Anime}">
              <StackPanel Spacing="6">
                <Grid Width="118" Height="148">
                  <Image Source="{Binding Poster}" IsVisible="{Binding HasPoster}" Stretch="UniformToFill" />
                  <Border IsVisible="{Binding ShowPosterPlaceholder}" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding PosterFallbackText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <!-- 下面三行固定行高：标题一行/两行会让同排卡片高矮不一（下载页同样处理过）。 -->
                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Height="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Height="18" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MetaText}" Classes="cap" Height="18" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Anime.TypeDescription}" Classes="cap" Height="18" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
