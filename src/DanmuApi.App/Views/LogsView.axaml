<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:core="using:DanmuApi.Core"
             xmlns:views="using:DanmuApi.App.Views"
             x:Class="DanmuApi.App.Views.LogsView"
             x:DataType="vm:LogsPageViewModel">
  <UserControl.Resources>
    <views:LogLevelBrushConverter x:Key="LogLevelBrush" />
    <views:BoolToTextWrappingConverter x:Key="BoolToWrapping" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 筛选胶囊按钮：级别与分类那两排可点的筛选项。
         此前这个 Button.chip 定义在 App.axaml 里，但全应用只有本页在用，
         与 Shell 的 Border.chip（只读标签）是两种东西，混在一个名字下容易误读，
         所以搬到这里并改名 filter-chip。 -->
    <Style Selector="Button.filter-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.filter-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
    <Border Classes="card">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <ComboBox ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                    Width="160"
                    VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{Binding MatchSummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastUpdatedText}" Classes="cap" VerticalAlignment="Center" />
            <TextBlock Text="每 5 秒自动刷新" Classes="cap" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="刷新" Classes="secondary" Command="{Binding RefreshCommand}" />
            <Button Content="打开日志目录" Classes="ghost" Command="{Binding OpenLogDirectoryCommand}" IsEnabled="{Binding CanOpenLogDirectory}" />
            <Button Content="{Binding ExportButtonText}" Classes="secondary" Command="{Binding ExportCommand}" />
            <Button Content="{Binding CopyButtonText}" Classes="primary" Command="{Binding CopyCommand}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <TextBox Classes="field"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="搜索当前日志来源（边输入边筛选）"
                   VerticalContentAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <CheckBox Content="区分大小写" IsChecked="{Binding CaseSensitive, Mode=TwoWay}" />
            <CheckBox Content="跟随最新" IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
            <CheckBox Content="自动换行" IsChecked="{Binding WordWrap, Mode=TwoWay}" />
            <Button Content="清除筛选" Classes="ghost" Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding IsFilterActive}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Spacing="8">
      <ItemsControl ItemsSource="{Binding LevelOptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LogLevelFilterOption">
            <Button Classes="filter-chip"
                    Content="{Binding}"
                    Command="{Binding ((vm:LogsPageViewModel)DataContext).SelectLevelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Value}"
                    Margin="0,0,6,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:LogCategoryCount">
            <Button Classes="filter-chip"
                    Content="{Binding DisplayText}"
                    Command="{Binding ((vm:LogsPageViewModel)DataContext).SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Name}"
                    ToolTip.Tip="{Binding Name}"
                    Margin="0,0,6,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding CopyStatusHint}" Classes="cap" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1"
              Content="{Binding NewLogsButtonText}"
              Command="{Binding ViewLatestCommand}"
              Classes="primary"
              IsVisible="{Binding HasPendingNewLogs}" />
    </Grid>

    <Border Grid.Row="3" Classes="log-terminal">
      <Grid>
        <ListBox x:Name="LogList"
                 ItemsSource="{Binding FilteredEntries}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single"
                 Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:LogEntry">
              <Grid ColumnDefinitions="58,152,58,*" ColumnSpacing="10" Margin="0,1">
                <TextBlock Text="{Binding SequenceText}"
                           Classes="log-seq"
                           Foreground="{DynamicResource LogMutedBrush}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Classes="log-time" />
                <TextBlock Grid.Column="2"
                           Text="{Binding LevelText}"
                           Classes="log-level"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                <views:HighlightTextBlock Grid.Column="3"
                                          Text="{Binding Message}"
                                          SearchTerm="{Binding ((vm:LogsPageViewModel)DataContext).SearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          HighlightBrush="{DynamicResource LogHighlightBrush}"
                                          HighlightForegroundBrush="{DynamicResource LogHighlightTextBrush}"
                                          FontFamily="Cascadia Mono,Consolas"
                                          FontSize="12.5"
                                          Foreground="{DynamicResource LogTextBrush}"
                                          TextWrapping="{Binding ((vm:LogsPageViewModel)DataContext).WordWrap, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToWrapping}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border IsVisible="{Binding IsEmpty}"
                Background="{DynamicResource LogSurfaceBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding EmptyStateText}" Classes="terminal-text" HorizontalAlignment="Center" />
            <Button Content="刷新" Classes="secondary" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
