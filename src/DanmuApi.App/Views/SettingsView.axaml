<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:controls="using:DanmuApi.App.Controls"
             x:Class="DanmuApi.App.Views.SettingsView"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.Styles>
    <!-- 设置行：一行一件事，行间用 1px 分隔线，最后一行不带线。 -->
    <Style Selector="Border.setting-row">
      <Setter Property="Padding" Value="0,16" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.setting-row:last-child">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.setting-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.setting-description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ToggleSwitch.setting-control">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="OnContent" Value="开启" />
      <Setter Property="OffContent" Value="关闭" />
    </Style>
  </UserControl.Styles>

  <!-- 侧栏外观与工具页保持一致（宽度 208、圆角 8、内边距 8、rail 行）；
         工具页的测试锁着它自己那条侧栏 208，这两页并排切换时必须长得一样，
         所以两边的侧栏要一起改。 -->
  <Grid ColumnDefinitions="208,*" ColumnSpacing="20">
    <Border Classes="rail">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <TextBlock Text="设置分类" Classes="overline" Margin="10,8,10,4" />
        <ListBox Grid.Row="1"
                 Classes="rail-list"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsCategory">
              <StackPanel Spacing="3" Margin="10,9">
                <TextBlock Text="{Binding Title}" Classes="rail-title" />
                <TextBlock Text="{Binding Description}" Classes="rail-caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14" MaxWidth="940" HorizontalAlignment="Stretch">
        <StackPanel Spacing="3" Margin="2,0,0,4">
          <TextBlock Text="{Binding SelectedCategory.Title}" Classes="h1" />
          <TextBlock Text="{Binding SelectedCategoryDescription}" Classes="sub" />
        </StackPanel>

        <ContentControl Content="{Binding Backup}" IsVisible="{Binding IsBackupCategory}" />

        <Border Classes="card" IsVisible="{Binding IsGeneralCategory}">
          <StackPanel Spacing="0">
            <StackPanel Spacing="3" Margin="0,0,0,6">
              <TextBlock Text="窗口与启动" Classes="section" />
              <TextBlock Text="更改后立即保存；不会再要求额外点击保存按钮。" Classes="cap" />
            </StackPanel>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="6">
                  <TextBlock Text="系统通知" Classes="setting-title" />
                  <TextBlock Text="更新包含软件和核心更新；启动成功仅指开机自启。关闭通知不影响手动操作结果及错误提示。" Classes="setting-description" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <ComboBox ItemsSource="{Binding NotificationLevelOptions}" SelectedItem="{Binding SelectedNotificationLevelOption, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                  <Button Content="发送测试通知" Classes="compact" Command="{Binding TestNotificationCommand}" ToolTip.Tip="测试会绕过应用通知偏好，仍遵守 Windows 通知设置" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding NotificationStatusText}" Classes="cap" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="关闭窗口行为" Classes="setting-title" />
                  <TextBlock Text="决定关闭主窗口时退出服务，还是继续在托盘后台运行。" Classes="setting-description" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="240"
                          ItemsSource="{Binding CloseActionOptions}"
                          SelectedItem="{Binding SelectedCloseActionOption, Mode=TwoWay}"
                          VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="开机自启" Classes="setting-title" />
                  <TextBlock Text="登录 Windows 后在后台启动服务和托盘，不主动显示主窗口。" Classes="setting-description" />
                  <TextBlock Text="{Binding AutostartStatusText}" Classes="cap" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AutostartStateLabel}" FontWeight="SemiBold" />
                  <ToggleSwitch Classes="setting-control"
                                IsChecked="{Binding IsAutostartEnabled, Mode=OneWay}"
                                Command="{Binding ToggleAutostartCommand}"
                                IsEnabled="{Binding CanChangeAutostart}"
                                IsVisible="{Binding IsAutostartStateKnown}" />
                  <Button Content="重新读取状态" Classes="compact" Command="{Binding RefreshAutostartStatusCommand}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsThemeCategory}">
          <StackPanel Spacing="0">
            <StackPanel Spacing="3" Margin="0,0,0,6">
              <TextBlock Text="主题与外观" Classes="section" />
              <TextBlock Text="选择浅色、深色，或跟随 Windows 系统外观；选择后立即保存并生效。" Classes="cap" />
            </StackPanel>
            <Border Classes="setting-row">
              <StackPanel Spacing="10">
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="ThemeSystemOption"
                          Content="跟随系统"
                          Classes="theme-option"
                          Classes.theme-option-active="{Binding IsSystemThemeSelected}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="system"
                          IsEnabled="{Binding IsThemeAvailable}"
                          Margin="0,0,10,0"
                          AutomationProperties.Name="主题跟随系统" />
                  <Button x:Name="ThemeLightOption"
                          Content="浅色"
                          Classes="theme-option"
                          Classes.theme-option-active="{Binding IsLightThemeSelected}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="light"
                          IsEnabled="{Binding IsThemeAvailable}"
                          Margin="0,0,10,0"
                          AutomationProperties.Name="主题浅色" />
                  <Button x:Name="ThemeDarkOption"
                          Content="深色"
                          Classes="theme-option"
                          Classes.theme-option-active="{Binding IsDarkThemeSelected}"
                          Command="{Binding SetThemeCommand}"
                          CommandParameter="dark"
                          IsEnabled="{Binding IsThemeAvailable}"
                          AutomationProperties.Name="主题深色" />
                </WrapPanel>
                <TextBlock Text="{Binding ThemeSummaryText}" Classes="setting-description" />
                <TextBlock Text="跟随系统时，外观随 Windows 系统设置变化；标题栏的太阳/月亮按钮只在浅色与深色之间快速切换，并把结果保存为新的偏好。"
                           Classes="setting-description" />
              </StackPanel>
            </Border>
            <Border Classes="setting-row">
              <StackPanel Spacing="8" Orientation="Horizontal">
                <Button Content="立即切换浅色/深色"
                        Classes="secondary"
                        Command="{Binding ToggleThemeCommand}"
                        IsEnabled="{Binding IsThemeAvailable}"
                        ToolTip.Tip="{Binding ThemeToggleTooltip}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsServiceCategory}">
          <StackPanel Spacing="0">
            <StackPanel Spacing="3" Margin="0,0,0,6">
              <TextBlock Text="服务监听" Classes="section" />
              <TextBlock Text="端口与监听协议会直接影响局域网设备的访问地址。" Classes="cap" />
            </StackPanel>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="服务端口" Classes="setting-title" />
                  <TextBlock Text="端口编辑入口保留在概览页；运行中修改会按既有流程重启 Node。" Classes="setting-description" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="从概览页修改" Classes="cap" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="IPv6 双栈监听" Classes="setting-title" />
                  <TextBlock Text="对齐移动端：开启后同时接受 IPv4 与 IPv6 连接；IPv4 入口始终保留。" Classes="setting-description" />
                  <TextBlock Text="{Binding Ipv6StatusText}" Classes="setting-description" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              Classes="setting-control"
                              IsChecked="{Binding Ipv6Enabled, Mode=TwoWay}"
                              VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsStorageCategory}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="核心运行目录" Classes="section" />
              <TextBlock Text="Node、核心变体、config、日志与临时数据都位于当前运行根目录。更改后需要重启应用。" Classes="cap" TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="inset">
              <TextBlock Text="{Binding RuntimeRoot}" Classes="mono cap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RuntimeRoot}" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="打开目录" Command="{Binding OpenRuntimeRootCommand}" Classes="secondary" />
              <Button Content="更改位置" Command="{Binding ChooseRuntimeRootCommand}" Classes="primary" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsNetworkCategory}">
          <StackPanel Spacing="0">
            <StackPanel Spacing="3" Margin="0,0,0,6">
              <TextBlock Text="GitHub 与更新检查" Classes="section" />
              <TextBlock Text="线路、检查频率与更新动作都会立即保存。" Classes="cap" />
            </StackPanel>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="核心下载线路" Classes="setting-title" />
                  <TextBlock Text="{Binding GithubRouteStatusText}" Classes="setting-description" />
                </StackPanel>
                <Button Grid.Column="1" Width="240" Content="测速并选择" Command="{Binding ChooseGithubRouteCommand}" Classes="secondary" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="GitHub Token" Classes="setting-title" />
                  <TextBlock Text="{Binding GithubTokenStatusText}" Classes="setting-description" />
                  <TextBlock Text="Token 会先通过 GitHub 官方 API 验证，再保存到 Windows DPAPI 安全存储。" Classes="setting-description" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="240"
                        Content="{Binding GithubTokenActionText}"
                        Command="{Binding ConfigureGithubTokenCommand}"
                        Classes="secondary"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="前台检查间隔" Classes="setting-title" />
                  <TextBlock Text="回到前台时检查；手动检查不受该冷却时间限制。" Classes="setting-description" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <NumericUpDown Minimum="5" Maximum="1440" Value="{Binding ForegroundCheckIntervalMinutes, Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" Text="分钟" Classes="cap" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="后台检查间隔" Classes="setting-title" />
                  <TextBlock Text="隐藏到托盘时静默检查；与前台和手动检查共享请求状态。" Classes="setting-description" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <NumericUpDown Minimum="15" Maximum="10080" Value="{Binding BackgroundCheckIntervalMinutes, Mode=TwoWay}" />
                  <TextBlock Grid.Column="1" Text="分钟" Classes="cap" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="后台静默检查" Classes="setting-title" />
                  <TextBlock Text="关闭后只保留前台检查和手动检查。" Classes="setting-description" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" Classes="setting-control" IsChecked="{Binding BackgroundCheckEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="setting-row">
              <Grid ColumnDefinitions="*,240" ColumnSpacing="28">
                <StackPanel Spacing="4">
                  <TextBlock Text="发现更新后的动作" Classes="setting-title" />
                  <TextBlock Text="自动更新会停服、事务替换并尝试恢复；默认仅通知。" Classes="setting-description" />
                  <TextBlock Text="{Binding UpdateActionDescription}" Classes="cap" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="240"
                          ItemsSource="{Binding UpdateActionOptions}"
                          SelectedValue="{Binding UpdateAction, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Value}"
                          VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsSecurityCategory}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding AdminModeStatusText}" Classes="section" />
                <TextBlock Text="{Binding AdminTokenStatusText}" Classes="cap" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="退出管理员模式"
                      Command="{Binding AdminLogoutCommand}"
                      Classes="secondary"
                      IsVisible="{Binding IsAdminMode}"
                      VerticalAlignment="Center" />
            </Grid>

            <Border Classes="rule" />

            <StackPanel Spacing="12" IsVisible="{Binding IsAdminFirstSetup}">
              <StackPanel Spacing="4">
                <TextBlock Text="首次配置" Classes="section" />
                <TextBlock Text="{Binding AdminSecurityDescription}" Classes="cap" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="新管理员密码" Classes="setting-title" />
                  <TextBox Classes="field"
                           Text="{Binding AdminTokenInput, Mode=TwoWay}"
                           PasswordChar="•"
                           Watermark="输入新的 ADMIN_TOKEN"
                           controls:EnterKeyCommand.Command="{Binding AdminLoginCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="确认管理员密码" Classes="setting-title" />
                  <TextBox Classes="field"
                           Text="{Binding AdminTokenConfirmation, Mode=TwoWay}"
                           PasswordChar="•"
                           Watermark="再次输入"
                           controls:EnterKeyCommand.Command="{Binding AdminLoginCommand}" />
                </StackPanel>
              </Grid>
              <Border Classes="notice-panel">
                <TextBlock Text="当前没有内置管理员密码。只有这里输入并确认的值才会写入核心 config/.env；写入失败或回读不一致时不会进入管理员模式。"
                           Classes="cap" TextWrapping="Wrap" />
              </Border>
              <Button Content="{Binding AdminLoginLabel}"
                      Command="{Binding AdminLoginCommand}"
                      IsEnabled="{Binding CanSubmitAdmin}"
                      Classes="primary"
                      HorizontalAlignment="Right" />
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsAdminLoginRequired}">
              <StackPanel Spacing="4">
                <TextBlock Text="验证身份" Classes="section" />
                <TextBlock Text="{Binding AdminSecurityDescription}" Classes="cap" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox Classes="field"
                         Text="{Binding AdminTokenInput, Mode=TwoWay}"
                         PasswordChar="•"
                         Watermark="输入已配置的 ADMIN_TOKEN"
                         controls:EnterKeyCommand.Command="{Binding AdminLoginCommand}" />
                <Button Grid.Column="1"
                        Content="{Binding AdminLoginLabel}"
                        Command="{Binding AdminLoginCommand}"
                        IsEnabled="{Binding CanSubmitAdmin}"
                        Classes="primary" />
              </Grid>
              <TextBlock Text="输入错误只会拒绝登录，不会覆盖当前 ADMIN_TOKEN。" Classes="cap" />
            </StackPanel>

            <StackPanel Spacing="12" IsVisible="{Binding IsAdminMode}">
              <TextBlock Text="{Binding AdminSecurityDescription}" Classes="cap" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="inset">
                  <StackPanel Spacing="3">
                    <TextBlock Text="核心配置写入" FontWeight="SemiBold" />
                    <TextBlock Text="允许写入 .env 中的访问 Token 和配置变量。" Classes="cap" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="inset">
                  <StackPanel Spacing="3">
                    <TextBlock Text="管理操作" FontWeight="SemiBold" />
                    <TextBlock Text="允许调用清理缓存等管理员接口。" Classes="cap" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="管理员会话由 Windows DPAPI 保护，并且只在会话值与当前 .env 的 ADMIN_TOKEN 完全一致时有效。"
                         Classes="cap" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsDiagnosticsCategory}">
          <StackPanel Spacing="8">
            <TextBlock Text="Windows 通知" Classes="section" />
            <TextBlock Text="{Binding NotificationStatusText}" Classes="cap" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="发送测试通知" Command="{Binding TestNotificationCommand}" Classes="secondary" Margin="0,8,12,8" />
              <Button Content="系统通知设置" Command="{Binding OpenSystemNotificationsCommand}" Classes="ghost" Margin="0,8,0,8" />
            </WrapPanel>
            <Border Classes="rule" />
            <TextBlock Text="诊断与日志" Classes="section" />
            <TextBlock Text="运行状态、健康检查时间和失败原因显示在概览页；核心业务日志、Node 输出和宿主日志可在活动页查看。" Classes="cap" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding ApplicationUpdates}" IsVisible="{Binding IsAboutCategory}" />
        <Border Classes="card" IsVisible="{Binding IsAboutCategory}">
          <StackPanel Spacing="6">
            <TextBlock Text="弹幕 API Windows 控制台" Classes="section" />
            <TextBlock Text="Avalonia 11 · .NET 8 · win-x64" Classes="cap" />
            <TextBlock Text="核心版本与更新操作位于核心工作台。" Classes="cap" />
          </StackPanel>
        </Border>

        <Border Classes="notice-panel" IsVisible="{Binding HasDiagnostic}">
          <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
