<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.FrpTunnelLogView"
             x:DataType="vm:FrpTunnelLogViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock Text="frp 进程日志" Classes="section" />
        <TextBlock Text="{Binding LogPathText}" Classes="cap" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="刷新" Classes="secondary" Command="{Binding RefreshCommand}" />
        <Button Content="打开日志目录" Classes="ghost" Command="{Binding OpenLogDirectoryCommand}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="cap" TextWrapping="Wrap" />

    <Border Grid.Row="2" Classes="inset">
      <SelectableTextBlock Text="{Binding LogText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
