<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:rt="using:DanmuApi.Runtime"
             xmlns:controls="using:DanmuApi.App.Controls"
             x:Class="DanmuApi.App.Views.AutoMatchView"
             x:DataType="vm:AutoMatchPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14">
      <StackPanel Spacing="3"><TextBlock Text="自动匹配" Classes="section-title" /><TextBlock Text="把视频文件名交给核心匹配；匹配算法、标题清洗和跨季映射由 Node 核心负责。" Classes="body-muted" TextWrapping="Wrap" /></StackPanel>
      <Border Classes="dashboard-panel"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Text="{Binding FileName, Mode=TwoWay}" Watermark="例如：生万物 S02E08" controls:EnterKeyCommand.Command="{Binding MatchCommand}" /><Button Grid.Column="1" Content="开始匹配" Classes="primary-action" Command="{Binding MatchCommand}" IsEnabled="{Binding !IsBusy}" /></Grid></Border>
      <TextBlock Text="{Binding Diagnostic}" Classes="body-muted" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Matches}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="rt:DanmuAnimeMatch"><Border Classes="muted-row" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="{Binding AnimeTitle}" Classes="section-title" /><TextBlock Text="{Binding EpisodeTitle}" /><TextBlock Text="{Binding TypeDescription}" Classes="body-muted" /><TextBlock Text="{Binding EpisodeId, StringFormat='集 ID：{0}'}" Classes="mono-text body-muted" /></StackPanel><Button Grid.Column="1" Content="查看弹幕" Classes="secondary-action" Command="{Binding $parent[ItemsControl].DataContext.OpenMatchCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
