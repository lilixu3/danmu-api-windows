<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.ActivityView"
             x:DataType="vm:ActivityPageViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="18">
    <StackPanel Spacing="4">
      <TextBlock Text="运行日志" Classes="h1" />
      <TextBlock Text="查看服务运行输出、筛选日志并定位异常。" Classes="sub" TextWrapping="Wrap" />
    </StackPanel>
    <ContentControl Grid.Row="1" Content="{Binding Logs}" />
  </Grid>
</UserControl>
