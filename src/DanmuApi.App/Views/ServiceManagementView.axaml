<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:runtime="using:DanmuApi.Runtime"
             x:Class="DanmuApi.App.Views.ServiceManagementView"
             x:DataType="vm:ServiceManagementPageViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12">
      <TextBlock Text="查看访问过本服务的设备，设置 IP 黑名单。支持 IPv4 / IPv6，不支持白名单、CIDR 或正则规则。" Classes="cap" TextWrapping="Wrap" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Statistics}" Classes="cap" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="刷新设备" Classes="secondary" Command="{Binding RefreshCommand}" />
              <Button Content="保存访问控制" Classes="primary" Command="{Binding SaveCommand}" />
              <Button Content="保存并清除设备记录…" Classes="ghost" Command="{Binding ClearDevicesCommand}" />
            </StackPanel>
          </Grid>
          <Border Classes="rule" />
          <StackPanel Spacing="6">
            <TextBlock Text="黑名单 IP（每行一条，也可用逗号分隔）" Classes="stat-label" />
            <TextBox Classes="field mono"
                     Text="{Binding BlacklistText}"
                     AcceptsReturn="True"
                     MinHeight="100"
                     MaxHeight="220"
                     TextWrapping="Wrap"
                     IsEnabled="{Binding HasSnapshot}"
                     Watermark="192.168.1.20" />
            <CheckBox Content="启用黑名单拦截" IsChecked="{Binding BlacklistEnabled}" IsEnabled="{Binding HasSnapshot}" />
            <TextBlock Text="关闭拦截会保留规则。本机回环访问始终放行。修改前请先刷新。" Classes="cap" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasSnapshot}">
        <StackPanel Spacing="8">
          <TextBlock Text="访问过的设备" Classes="section" />
          <Border Classes="rule" />
          <!-- 设备行改用分隔线：每台设备套一个描边小卡会在设备多时叠出一堆边框。 -->
          <ListBox ItemsSource="{Binding Devices}" Classes="records-list" MaxHeight="320" MinHeight="80" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="runtime:AccessDevice">
                <Border Classes="rule" Padding="0,3,0,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Ip}" Classes="mono" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="请求 / 允许 / 拦截：" Classes="cap" />
                      <TextBlock Text="{Binding TotalRequests}" />
                      <TextBlock Text=" / " /><TextBlock Text="{Binding AllowedRequests}" />
                      <TextBlock Text=" / " /><TextBlock Text="{Binding BlockedRequests}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="黑名单：" Classes="cap" />
                      <TextBlock Text="{Binding InBlacklist}" Margin="0,0,12,0" />
                      <TextBlock Text="正在拦截：" Classes="cap" />
                      <TextBlock Text="{Binding EffectiveBlocked}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="日志清理" Classes="section" />
          <Border Classes="rule" />
          <TextBlock Text="仅清空核心内存日志；宿主日志与磁盘日志文件保留。可在活动日志页查看核心日志。" Classes="cap" TextWrapping="Wrap" />
          <Button Content="清空核心内存日志…" Classes="secondary" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Diagnostic}" Classes="cap" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
