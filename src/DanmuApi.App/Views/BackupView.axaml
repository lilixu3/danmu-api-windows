<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels" xmlns:controls="using:DanmuApi.App.Controls" x:Class="DanmuApi.App.Views.BackupView" x:DataType="vm:BackupPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <!-- 备份页是设置页「备份与恢复」分类的内容，观感必须与设置页其它分类一致：
         共享词汇（section / cap / inset / rule / field / secondary / primary / danger / mono），
         不再用裸 Fluent 画刷与 20px 手写字号。 -->
    <StackPanel Margin="0" Spacing="18" HorizontalAlignment="Stretch">
      <TextBlock Text="在本地保存配置，或通过 WebDAV 在设备间迁移。恢复前始终展示预览。" Classes="cap" TextWrapping="Wrap" />
      <Border Classes="inset">
        <TextBlock Text="{Binding PrivacyNotice}" Classes="cap" TextWrapping="Wrap" />
      </Border>
      <StackPanel Spacing="16" IsEnabled="{Binding IsIdle}">
        <TextBlock Text="本地备份" Classes="section" />
        <WrapPanel Orientation="Horizontal">
          <Button Content="导出配置备份…" Command="{Binding ExportCommand}" Classes="primary" Margin="0,0,12,8" />
          <Button Content="打开备份并预览…" Command="{Binding OpenCommand}" Classes="secondary" Margin="0,0,12,8" />
        </WrapPanel>
        <Border Classes="rule" />
        <TextBlock Text="WebDAV" Classes="section" />
        <TextBlock Text="填写已有集合的 HTTPS 地址，例如 https://example.com/dav/DanmuApi/。与移动端共用 app-backup.json；不会自动创建或猜测目录。" Classes="cap" TextWrapping="Wrap" />
        <TextBlock Text="集合地址" Classes="overline" />
        <TextBox Text="{Binding CollectionUrl}" Classes="field" Watermark="https://example.com/dav/DanmuApi/" controls:EnterKeyCommand.Command="{Binding ListRemoteCommand}" />
        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Spacing="6">
            <TextBlock Text="用户名" Classes="overline" />
            <TextBox Text="{Binding Username}" Classes="field" controls:EnterKeyCommand.Command="{Binding ListRemoteCommand}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Text="密码 / 应用专用密码" Classes="overline" />
            <TextBox Text="{Binding Password}" Classes="field" PasswordChar="●" controls:EnterKeyCommand.Command="{Binding ListRemoteCommand}" />
          </StackPanel>
        </Grid>
        <WrapPanel>
          <Button Content="保存凭据" Command="{Binding SaveCredentialsCommand}" Classes="secondary" Margin="0,0,12,8" />
          <Button Content="读取已保存凭据" Command="{Binding LoadCredentialsCommand}" Classes="secondary" Margin="0,0,12,8" />
          <Button Content="删除已保存凭据" Command="{Binding ClearCredentialsCommand}" Classes="secondary" Margin="0,0,12,8" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="检查集合" Command="{Binding ListRemoteCommand}" Classes="secondary" Margin="0,0,12,8" />
          <Button Content="上传当前配置…" Command="{Binding UploadCommand}" Classes="secondary" Margin="0,0,12,8" />
          <Button Content="下载并预览" Command="{Binding DownloadCommand}" Classes="secondary" Margin="0,0,12,8" />
        </WrapPanel>
        <Border Classes="rule" />
        <TextBlock Text="恢复预览" Classes="section" />
        <TextBlock Text="迁移 Environment、收藏，以及主题 / 通知级别 / 关闭行为三项桌面偏好。TOKEN、COOKIE、URL、宿主变量及机器身份不迁移；访问规则、Android 专属设置、核心来源及二进制不恢复。" Classes="cap" TextWrapping="Wrap" />
        <Border Classes="inset">
          <SelectableTextBlock Text="{Binding PreviewText}" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
        </Border>
        <Button Content="确认并恢复配置…" Command="{Binding RestoreCommand}" Classes="danger" HorizontalAlignment="Left" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" Classes="cap" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
