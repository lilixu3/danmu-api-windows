<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels" x:Class="DanmuApi.App.Views.BackupView" x:DataType="vm:BackupPageViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0" Spacing="18" MaxWidth="1050">
      <TextBlock Text="在本地保存配置，或通过 WebDAV 在设备间迁移。恢复前始终展示预览。" TextWrapping="Wrap" />
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Padding="16">
        <TextBlock Text="{Binding PrivacyNotice}" TextWrapping="Wrap" />
      </Border>
      <StackPanel Spacing="16" IsEnabled="{Binding IsIdle}">
        <TextBlock Text="本地备份" FontSize="20" FontWeight="SemiBold" />
        <WrapPanel Orientation="Horizontal">
          <Button Content="导出配置备份…" Command="{Binding ExportCommand}" Margin="0,0,12,8" />
          <Button Content="打开备份并预览…" Command="{Binding OpenCommand}" Margin="0,0,12,8" />
        </WrapPanel>
        <Separator />
        <TextBlock Text="WebDAV" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="填写已有集合的 HTTPS 地址，例如 https://example.com/dav/DanmuApi/。与移动端共用 app-backup.json；不会自动创建或猜测目录。" TextWrapping="Wrap" />
        <TextBlock Text="集合地址" />
        <TextBox Text="{Binding CollectionUrl}" Watermark="https://example.com/dav/DanmuApi/" />
        <Grid ColumnDefinitions="*,16,*">
          <StackPanel Spacing="6"><TextBlock Text="用户名" /><TextBox Text="{Binding Username}" /></StackPanel>
          <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="密码 / 应用专用密码" /><TextBox Text="{Binding Password}" PasswordChar="●" /></StackPanel>
        </Grid>
        <WrapPanel>
          <Button Content="保存凭据" Command="{Binding SaveCredentialsCommand}" Margin="0,0,12,8" />
          <Button Content="读取已保存凭据" Command="{Binding LoadCredentialsCommand}" Margin="0,0,12,8" />
          <Button Content="删除已保存凭据" Command="{Binding ClearCredentialsCommand}" Margin="0,0,12,8" />
        </WrapPanel>
        <WrapPanel>
          <Button Content="检查集合" Command="{Binding ListRemoteCommand}" Margin="0,0,12,8" />
          <Button Content="上传当前配置…" Command="{Binding UploadCommand}" Margin="0,0,12,8" />
          <Button Content="下载并预览" Command="{Binding DownloadCommand}" Margin="0,0,12,8" />
        </WrapPanel>
        <Separator />
        <TextBlock Text="恢复预览" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="迁移 Environment、收藏，以及主题 / 通知级别 / 关闭行为三项桌面偏好。TOKEN、COOKIE、URL、宿主变量及机器身份不迁移；访问规则、Android 专属设置、核心来源及二进制不恢复。" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
        <Button Content="确认并恢复配置…" Command="{Binding RestoreCommand}" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
