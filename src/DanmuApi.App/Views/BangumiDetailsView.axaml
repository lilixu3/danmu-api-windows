<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:rt="using:DanmuApi.Runtime"
             x:Class="DanmuApi.App.Views.BangumiDetailsView"
             x:DataType="vm:BangumiDetailsPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
    <Button Content="返回上一层" Classes="back-action" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
    <StackPanel Spacing="3"><TextBlock Text="番剧详情" Classes="section-title" /><TextBlock Text="{Binding Anime.AnimeTitle}" Classes="page-title" FontSize="22" /><TextBlock Text="{Binding Diagnostic}" Classes="body-muted" TextWrapping="Wrap" /></StackPanel>
    <Button Content="加载番剧详情" Classes="primary-action" Command="{Binding LoadCommand}" />
    <Border Classes="dashboard-panel"><StackPanel Spacing="8"><TextBlock Text="剧集列表" Classes="section-title" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding EpisodeQuery, Mode=TwoWay}" Watermark="搜索标题或输入集数定位" /><Button Grid.Column="1" Content="定位集数" Classes="secondary-action" Command="{Binding JumpToEpisodeCommand}" /></Grid><TextBlock Text="{Binding EpisodeSummaryText}" Classes="body-muted" /><ItemsControl ItemsSource="{Binding VisibleEpisodes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="rt:DanmuEpisode"><Border Classes="muted-row" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="2"><TextBlock Text="{Binding EpisodeNumber, StringFormat='第 {0} 集'}" FontWeight="SemiBold" /><TextBlock Text="{Binding EpisodeTitle}" /><TextBlock Text="{Binding AirDate}" Classes="body-muted" /></StackPanel><Button Grid.Column="1" Content="获取弹幕" Classes="secondary-action" Command="{Binding $parent[ItemsControl].DataContext.SelectEpisodeCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
