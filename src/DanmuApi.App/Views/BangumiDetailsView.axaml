<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:rt="using:DanmuApi.Runtime"
             xmlns:controls="using:DanmuApi.App.Controls"
             x:Class="DanmuApi.App.Views.BangumiDetailsView"
             x:DataType="vm:BangumiDetailsPageViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
    <Button Content="返回上一层" Classes="secondary" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
    <StackPanel Spacing="3"><TextBlock Text="番剧详情" Classes="section" /><TextBlock Text="{Binding Anime.AnimeTitle}" Classes="h1" TextWrapping="Wrap" /><TextBlock Text="{Binding Diagnostic}" Classes="cap" TextWrapping="Wrap" /></StackPanel>
    <Button Content="加载番剧详情" Classes="primary" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
    <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="剧集列表" Classes="section" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="field" Text="{Binding EpisodeQuery, Mode=TwoWay}" Watermark="搜索标题或输入集数定位" controls:EnterKeyCommand.Command="{Binding JumpToEpisodeCommand}" /><Button Grid.Column="1" Content="定位集数" Classes="secondary" Command="{Binding JumpToEpisodeCommand}" /></Grid><TextBlock Text="{Binding EpisodeSummaryText}" Classes="cap" /><Border Classes="rule" /><ItemsControl ItemsSource="{Binding VisibleEpisodes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="rt:DanmuEpisode"><Border Classes="rule"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,7"><StackPanel Spacing="2"><TextBlock Text="{Binding EpisodeNumber, StringFormat='第 {0} 集'}" FontWeight="SemiBold" /><TextBlock Text="{Binding EpisodeTitle}" /><TextBlock Text="{Binding AirDate}" Classes="cap" /></StackPanel><Button Grid.Column="1" Content="获取弹幕" Classes="secondary" Command="{Binding $parent[ItemsControl].DataContext.SelectEpisodeCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
