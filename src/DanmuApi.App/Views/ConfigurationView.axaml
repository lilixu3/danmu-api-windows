<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.ConfigurationView"
             x:DataType="vm:ConfigurationPageViewModel">
  <UserControl.Styles>
    <!-- rail 条目的标题/说明排版（rail-title / rail-caption）与选中态前景色
         已经提升到 Styles\Shell.axaml 全局，配置页、设置页、工具页共用一份定义。 -->

    <!-- 变量行：键名等宽 + 说明单行截断；行底 1px 分隔线。 -->
    <Style Selector="ListBox.variable-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <!-- 行内操作按钮：用按钮自己的类，不用纯类名选择器。
         App.axaml 里有全局的 `Button.chip` 与 `Button.compact-action`，
         纯类名选择器无法限定「只在本列表里生效」。 -->
    <Style Selector="Button.row-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.row-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.row-action:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Button.row-action.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.row-action.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="TextBlock.variable-key">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- 三栏档位：详情列用 Auto（面板隐藏时收成 0，列表独占宽度）。
       这里的初始值与 ConfigurationView.axaml.cs 的 ThreeColumn 分支必须一致：
       断点判断只比较列数，初始列数若与目标档位相同就会直接早退，不会再改写列定义。 -->
  <Grid x:Name="LayoutRoot" ColumnDefinitions="216,*,Auto" ColumnSpacing="14">
    <!-- ── 分类侧栏 ──────────────────────────────────────────────────── -->
    <Border x:Name="CategoryRail" Classes="rail" VerticalAlignment="Top">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel x:Name="RailHeader" Margin="8,6,8,2" Spacing="3">
          <TextBlock Text="配置分类" Classes="overline" />
          <TextBlock Text="来自当前核心 envs.js" Classes="rail-caption" />
        </StackPanel>
        <ListBox x:Name="CategoryList"
                 Grid.Row="1"
                 Classes="rail-list"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemsPanel>
            <!-- 竖排用 VirtualizingStackPanel：分类多时可滚动。 -->
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfigurationCategory">
              <StackPanel Spacing="2" Margin="10,7">
                <TextBlock Text="{Binding Title}" Classes="rail-title" />
                <TextBlock Text="{Binding Description}" Classes="rail-caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ── 变量列表 ──────────────────────────────────────────────────── -->
    <Grid x:Name="ListColumn" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding PageTitle}" Classes="h1" />
          <TextBlock Text="{Binding PageSubtitle}" Classes="sub" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="刷新"
                Classes="secondary"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="10">
        <Border Classes="notice-panel" IsVisible="{Binding HasDiagnostic}">
          <TextBlock Text="{Binding DiagnosticText}" Classes="cap" TextWrapping="Wrap" />
        </Border>
        <!-- 搜索框靠左：不写 `*` 拉伸列，只给固定宽度上限。
             右侧「清空」只在有关键词时出现，一键回到当前分类的完整列表。 -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
          <TextBox Classes="field"
                   Width="260"
                   HorizontalAlignment="Left"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="搜索全部变量名或说明" />
          <Button Grid.Column="1"
                  Content="清空关键词"
                  Classes="secondary row-action"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasSearchText}"
                  Command="{Binding ClearSearchCommand}" />
          <Border Grid.Column="2" Classes="chip neutral">
            <TextBlock Text="{Binding CoreSummary}" />
          </Border>
        </Grid>
        <!-- 搜索态提示：明确「以下列出的是包含关键词的全部变量」并给出命中数。 -->
        <Border Classes="notice-panel" IsVisible="{Binding HasSearchText}">
          <TextBlock Text="{Binding SearchSummary}" Classes="cap" TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Grid.Row="2" Classes="card" Padding="0">
        <Grid>
          <ListBox x:Name="VariableList"
                   Classes="variable-list"
                   ItemsSource="{Binding FilteredVariables}"
                   SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionMode="Single"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConfigurationVariableRow">
                  <!-- 行结构：左边「键 + 一个状态胶囊」+ 当前值框 + 说明；右边两个操作按钮。
                       胶囊在键名右侧，方便一眼看出这一行是否已被 .env 覆盖。 -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,9">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Key}" Classes="variable-key" VerticalAlignment="Center" />
                      <!-- 「已配置」用绿胶囊；未配置时才显示「核心默认」这类来源，两者不同时出现，
                           避免一行挂两个语义重复的标签。 -->
                      <Border Classes="chip ok" VerticalAlignment="Center" IsVisible="{Binding IsConfigured}">
                        <TextBlock Text="已配置" />
                      </Border>
                      <Border Classes="chip neutral" VerticalAlignment="Center" IsVisible="{Binding ShowSourceChip}">
                        <TextBlock Text="{Binding Source}" />
                      </Border>
                    </StackPanel>
                    <!-- 当前值框：默认两行封顶，超长值折叠，右侧「展开 / 收起」自行控制。 -->
                    <Border Classes="inset">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <SelectableTextBlock Text="{Binding CurrentValueText}"
                                             Classes="mono"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxLines="2"
                                             IsVisible="{Binding !IsValueExpanded}" />
                        <SelectableTextBlock Grid.Column="0"
                                             Text="{Binding CurrentValueText}"
                                             Classes="mono"
                                             FontSize="11.5"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding IsValueExpanded}" />
                        <Button Grid.Column="1"
                                Content="{Binding ValueToggleText}"
                                Classes="row-action"
                                FontSize="11"
                                Padding="6,2"
                                VerticalAlignment="Top"
                                IsVisible="{Binding IsValueExpandable}"
                                Command="{Binding $parent[ListBox].((vm:ConfigurationPageViewModel)DataContext).ToggleRowValueCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Description}"
                               Classes="cap"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- 两个按钮固定宽度右对齐，保证所有行竖着对齐成一列。 -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="{Binding EditorActionText}"
                            Classes="row-action"
                            Width="52"
                            Command="{Binding $parent[ListBox].((vm:ConfigurationPageViewModel)DataContext).EditVariableCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="{Binding ResetActionText}"
                            Classes="row-action danger"
                            Width="52"
                            IsEnabled="{Binding IsConfigured}"
                            Command="{Binding $parent[ListBox].((vm:ConfigurationPageViewModel)DataContext).DeleteVariableCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="cap"
                     Margin="14,16"
                     IsVisible="{Binding !HasVariables}"
                     Text="当前筛选条件下没有变量。" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── 详情面板 ────────────────────────────────────────────────────
         只在选中变量时出现：没有选中项时整块隐藏，所在列由 Auto 收成 0，
         列表因此独占整行宽度。以前这里留一个空卡片 + 一行「请选择一个变量」的提示，
         全屏下那块空白单独挂在右侧很扎眼，且提示本身没有信息量。 -->
    <Border x:Name="DetailPanel"
            Grid.Column="2"
            Classes="card"
            Width="320"
            VerticalAlignment="Top"
            IsVisible="{Binding HasSelectedVariable}">
      <Grid>
        <StackPanel Spacing="12" IsVisible="{Binding HasSelectedVariable}">
          <StackPanel Spacing="3">
            <TextBlock Text="选中变量" Classes="overline" />
            <TextBlock Text="{Binding SelectedVariableKey}"
                       Classes="mono"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="5">
            <Border Classes="chip accent">
              <TextBlock Text="{Binding SelectedVariableType}" />
            </Border>
            <Border Classes="chip neutral">
              <TextBlock Text="{Binding SelectedVariableSource}" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="当前值" Classes="overline" />
            <Border Classes="inset">
              <SelectableTextBlock Text="{Binding SelectedVariableValue}"
                                   Classes="mono"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="说明" Classes="overline" />
            <TextBlock Text="{Binding SelectedVariableDescription}" Classes="cap" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SelectedVariableActionText}"
                    Classes="primary"
                    Command="{Binding EditVariableCommand}"
                    CommandParameter="{Binding SelectedVariable}" />
            <Button Content="恢复默认"
                    Classes="danger"
                    IsEnabled="{Binding CanResetSelectedVariable}"
                    Command="{Binding DeleteVariableCommand}"
                    CommandParameter="{Binding SelectedVariable}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
