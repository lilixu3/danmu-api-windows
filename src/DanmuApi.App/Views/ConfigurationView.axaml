<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.ConfigurationView"
             x:DataType="vm:ConfigurationPageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.configuration-row">
      <Setter Property="Padding" Value="0,14" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.configuration-row:last-child">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.configuration-key">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.configuration-description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="216,*" ColumnSpacing="20">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <StackPanel Margin="10,8,10,4" Spacing="3">
          <TextBlock Text="配置分类" Classes="overline" />
          <TextBlock Text="来自当前核心 envs.js" Classes="body-muted" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox Grid.Row="1"
                 Classes="settings-list"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfigurationCategory">
              <StackPanel Spacing="3" Margin="10,9">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="body-muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="3" Margin="2,0,0,0">
          <TextBlock Text="{Binding PageTitle}" Classes="page-title" FontSize="22" />
          <TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Grid.Column="1"
                 Width="250"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="搜索全部变量名或说明"
                 VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Content="刷新"
                Classes="secondary-action"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="960" HorizontalAlignment="Stretch">
          <Border Classes="notice-panel" IsVisible="{Binding HasDiagnostic}">
            <TextBlock Text="{Binding DiagnosticText}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="dashboard-panel">
            <ItemsControl ItemsSource="{Binding FilteredVariables}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConfigurationVariableRow">
                  <Border Classes="configuration-row">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Key}" Classes="configuration-key" />
                        <TextBlock Text="{Binding Description}"
                                   Classes="configuration-description"
                                   MaxWidth="720" />
                        <TextBlock Text="{Binding CurrentValueText}"
                                   Classes="configuration-description"
                                   MaxWidth="720" />
                        <TextBlock Text="{Binding Source, StringFormat='来源：{0}'}"
                                   Classes="body-muted"
                                   FontSize="11" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="编辑"
                              Classes="compact-action"
                              VerticalAlignment="Center"
                              Command="{Binding ((vm:ConfigurationPageViewModel)DataContext).EditVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2"
                              Content="删除"
                              Classes="compact-action"
                              IsEnabled="{Binding IsConfigured}"
                              VerticalAlignment="Center"
                              Command="{Binding ((vm:ConfigurationPageViewModel)DataContext).DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
