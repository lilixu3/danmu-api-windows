<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             x:Class="DanmuApi.App.Views.ConfigurationView"
             x:DataType="vm:ConfigurationPageViewModel">
  <UserControl.Styles>
    <!-- 分类项：标题 + 说明两行。选中态由 Shell.axaml 的 ListBox.rail-list 提供。 -->
    <Style Selector="TextBlock.rail-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.rail-caption">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 变量行：键名等宽 + 说明单行截断；行底 1px 分隔线。 -->
    <Style Selector="ListBox.variable-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.variable-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>

    <Style Selector="TextBlock.variable-key">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="LayoutRoot" ColumnDefinitions="216,*,320" ColumnSpacing="14">
    <!-- ── 分类侧栏 ──────────────────────────────────────────────────── -->
    <Border x:Name="CategoryRail" Classes="rail" VerticalAlignment="Top">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <StackPanel Margin="8,6,8,2" Spacing="3">
          <TextBlock Text="配置分类" Classes="overline" />
          <TextBlock Text="来自当前核心 envs.js" Classes="rail-caption" />
        </StackPanel>
        <ListBox x:Name="CategoryList"
                 Grid.Row="1"
                 Classes="rail-list"
                 ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConfigurationCategory">
              <StackPanel Spacing="2" Margin="10,7">
                <TextBlock Text="{Binding Title}" Classes="rail-title" />
                <TextBlock Text="{Binding Description}" Classes="rail-caption" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- ── 变量列表 ──────────────────────────────────────────────────── -->
    <Grid x:Name="ListColumn" Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding PageTitle}" Classes="h1" />
          <TextBlock Text="{Binding PageSubtitle}" Classes="sub" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="刷新"
                Classes="secondary"
                Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="10">
        <Border Classes="notice-panel" IsVisible="{Binding HasDiagnostic}">
          <TextBlock Text="{Binding DiagnosticText}" Classes="cap" TextWrapping="Wrap" />
        </Border>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Classes="field"
                   MinWidth="160"
                   MaxWidth="360"
                   HorizontalAlignment="Stretch"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Watermark="搜索全部变量名或说明" />
          <Border Grid.Column="1" Classes="chip neutral">
            <TextBlock Text="{Binding CoreSummary}" />
          </Border>
        </Grid>
      </StackPanel>

      <Border Grid.Row="2" Classes="card" Padding="0">
        <Grid>
          <ListBox x:Name="VariableList"
                   Classes="variable-list"
                   ItemsSource="{Binding FilteredVariables}"
                   SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionMode="Single"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConfigurationVariableRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="14,9">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Key}" Classes="variable-key" />
                    <TextBlock Text="{Binding Description}"
                               Classes="cap"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Classes="chip neutral">
                      <TextBlock Text="{Binding Source}" />
                    </Border>
                    <Border Classes="chip ok" IsVisible="{Binding IsConfigured}">
                      <TextBlock Text="已配置" />
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="cap"
                     Margin="14,16"
                     IsVisible="{Binding !HasVariables}"
                     Text="当前筛选条件下没有变量。" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── 详情面板 ──────────────────────────────────────────────────── -->
    <Border x:Name="DetailPanel" Grid.Column="2" Classes="card" VerticalAlignment="Top">
      <Grid>
        <StackPanel Spacing="12" IsVisible="{Binding HasSelectedVariable}">
          <StackPanel Spacing="3">
            <TextBlock Text="选中变量" Classes="overline" />
            <TextBlock Text="{Binding SelectedVariableKey}"
                       Classes="mono"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="5">
            <Border Classes="chip accent">
              <TextBlock Text="{Binding SelectedVariableType}" />
            </Border>
            <Border Classes="chip neutral">
              <TextBlock Text="{Binding SelectedVariableSource}" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="当前值" Classes="overline" />
            <Border Classes="inset">
              <SelectableTextBlock Text="{Binding SelectedVariableValue}"
                                   Classes="mono"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="说明" Classes="overline" />
            <TextBlock Text="{Binding SelectedVariableDescription}" Classes="cap" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SelectedVariableActionText}"
                    Classes="primary"
                    Command="{Binding EditVariableCommand}"
                    CommandParameter="{Binding SelectedVariable}" />
            <Button Content="恢复默认"
                    Classes="danger"
                    IsEnabled="{Binding CanResetSelectedVariable}"
                    Command="{Binding DeleteVariableCommand}"
                    CommandParameter="{Binding SelectedVariable}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="cap"
                   TextWrapping="Wrap"
                   IsVisible="{Binding !HasSelectedVariable}"
                   Text="在左侧列表中选择一个变量，这里会显示它的类型、值来源、当前值与可执行的操作。" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
