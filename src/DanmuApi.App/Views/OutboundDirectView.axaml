<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DanmuApi.App.ViewModels"
             xmlns:controls="using:DanmuApi.App.Controls"
             x:Class="DanmuApi.App.Views.OutboundDirectView"
             x:DataType="vm:OutboundDirectViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.outbound-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.outbound-heading">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.outbound-status">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.outbound-status.ready">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.outbound-status.failed">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.outbound-indicator">
      <Setter Property="Background" Value="{DynamicResource TextFaintBrush}" />
    </Style>
    <Style Selector="Border.outbound-indicator.ready">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.outbound-indicator.failed">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.outbound-source">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.outbound-source.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="controls|SavedStateCheckBox.outbound-source-choice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.outbound-action">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="20">
    <Border x:Name="StatusPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,18">
      <StackPanel Spacing="15">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border Width="7" Height="7" CornerRadius="4" Classes="outbound-indicator"
                      Classes.ready="{Binding IsEngineReady}" Classes.failed="{Binding IsEngineFailed}" VerticalAlignment="Center" />
              <TextBlock Text="连接引擎" Classes="outbound-caption" />
            </StackPanel>
            <TextBlock x:Name="EngineStatus" Text="{Binding StatusText}" Classes="outbound-status"
                       Classes.ready="{Binding IsEngineReady}" Classes.failed="{Binding IsEngineFailed}" />
          </StackPanel>
          <controls:SavedStateToggleSwitch x:Name="EnabledToggle" Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}"
                        Command="{Binding ToggleEnabledCommand}" IsEnabled="{Binding CanToggleEnabled}"
                        OnContent="开启" OffContent="关闭" VerticalAlignment="Center"
                        AutomationProperties.Name="启用增强直连" />
        </Grid>
        <TextBlock x:Name="StatusDescription" Text="{Binding StatusDescription}" Classes="outbound-caption" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <WrapPanel VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
              <TextBlock Text="ECH" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="4" Padding="7,3">
              <TextBlock Text="HTTP/2 · HTTP/3" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshOutbound" Content="刷新" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}" Classes="ghost outbound-action" AutomationProperties.Name="刷新状态" />
            <Button x:Name="TestOutbound" Content="连接测速" Click="OpenDiagnostics"
                    IsEnabled="{Binding CanOpenDiagnostics}" Classes="primary outbound-action" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="增强哪些来源" Classes="outbound-heading" />
        <TextBlock Text="{Binding SourceSelectionText}" Classes="outbound-caption" VerticalAlignment="Center" />
      </Grid>
      <Grid x:Name="QuickSources" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"
            IsEnabled="{Binding CanToggleSource}">
        <Border Classes="outbound-source" Classes.selected="{Binding SavedBahamutSelected}">
          <controls:SavedStateCheckBox x:Name="QuickBahamut" Classes="outbound-source-choice" IsChecked="{Binding SavedBahamutSelected, Mode=OneWay}"
                    Command="{Binding ToggleSourceCommand}" CommandParameter="bahamut" AutomationProperties.Name="增强巴哈姆特直连">
            <StackPanel Spacing="4">
              <TextBlock Text="巴哈姆特" FontWeight="SemiBold" />
              <TextBlock Text="动画疯接口" Classes="outbound-caption" />
            </StackPanel>
          </controls:SavedStateCheckBox>
        </Border>
        <Border Grid.Column="1" Classes="outbound-source" Classes.selected="{Binding SavedTmdbSelected}">
          <controls:SavedStateCheckBox x:Name="QuickTmdb" Classes="outbound-source-choice" IsChecked="{Binding SavedTmdbSelected, Mode=OneWay}"
                    Command="{Binding ToggleSourceCommand}" CommandParameter="tmdb" AutomationProperties.Name="增强TMDB直连">
            <StackPanel Spacing="4">
              <TextBlock Text="TMDB" FontWeight="SemiBold" />
              <TextBlock Text="影视元数据" Classes="outbound-caption" />
            </StackPanel>
          </controls:SavedStateCheckBox>
        </Border>
        <Border Grid.Row="1" Classes="outbound-source" Classes.selected="{Binding SavedDandanSelected}">
          <controls:SavedStateCheckBox x:Name="QuickDandan" Classes="outbound-source-choice" IsChecked="{Binding SavedDandanSelected, Mode=OneWay}"
                    Command="{Binding ToggleSourceCommand}" CommandParameter="dandan" AutomationProperties.Name="增强弹弹play直连">
            <StackPanel Spacing="4">
              <TextBlock Text="弹弹play" FontWeight="SemiBold" />
              <TextBlock Text="弹幕匹配接口" Classes="outbound-caption" />
            </StackPanel>
          </controls:SavedStateCheckBox>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Classes="outbound-source" Classes.selected="{Binding SavedAnimekoSelected}">
          <controls:SavedStateCheckBox x:Name="QuickAnimeko" Classes="outbound-source-choice" IsChecked="{Binding SavedAnimekoSelected, Mode=OneWay}"
                    Command="{Binding ToggleSourceCommand}" CommandParameter="animeko" AutomationProperties.Name="增强Animeko直连">
            <StackPanel Spacing="4">
              <TextBlock Text="Animeko" FontWeight="SemiBold" />
              <TextBlock Text="动画与弹幕接口" Classes="outbound-caption" />
            </StackPanel>
          </controls:SavedStateCheckBox>
        </Border>
      </Grid>
      <TextBlock Text="勾选即保存，只控制增强连接，不改变核心的来源顺序。" Classes="outbound-caption" />
    </StackPanel>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,13">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="6">
          <TextBlock Text="连接策略" Classes="outbound-heading" />
          <TextBlock x:Name="ConnectionSummary" Text="{Binding ConnectionSummary}" Classes="outbound-caption" />
        </StackPanel>
        <Button x:Name="ConfigureOutbound" Grid.Column="1" Content="调整选项" Click="OpenConfiguration"
                IsEnabled="{Binding CanOpenConfiguration}" Classes="secondary outbound-action" VerticalAlignment="Center"
                AutomationProperties.Name="调整连接选项" />
      </Grid>
    </Border>

    <Border x:Name="RecentTest" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="最近测速" Classes="outbound-heading" />
          <TextBlock Grid.Column="1" Text="{Binding RecentTestTime}" Classes="outbound-caption" />
        </Grid>
        <TextBlock x:Name="NoRecentTest" Text="还没有测速结果。开启服务后，测一下所选来源的实际连接情况。"
                   IsVisible="{Binding !HasRecentTest}" Classes="outbound-caption" />
        <StackPanel x:Name="RecentTestResults" Spacing="9" IsVisible="{Binding HasRecentTest}">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding RecentNormalCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
              <TextBlock Text="连接正常" Classes="outbound-caption" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Binding RecentNeedsKeyCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="需要 API 密钥" Classes="outbound-caption" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{Binding RecentFailedCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="连接失败" Classes="outbound-caption" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding RecentTestSummary}" Classes="outbound-caption" />
        </StackPanel>
      </StackPanel>
    </Border>

    <SelectableTextBlock x:Name="RuntimeFailure" Text="{Binding Diagnostic}" IsVisible="{Binding HasDiagnostic}"
                         TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
    <StackPanel x:Name="RuntimeDetails" Spacing="10" IsVisible="{Binding HasRuntimeDetails}">
      <Button x:Name="RuntimeDetailsToggle" Content="查看运行详情" Click="ToggleRuntimeDetails" Classes="ghost" HorizontalAlignment="Left" />
      <StackPanel x:Name="RuntimeDetailsContent" Spacing="6" IsVisible="False">
        <TextBlock Text="{Binding CapabilityText}" Classes="outbound-caption" />
        <TextBlock Text="{Binding ProcessText}" Classes="outbound-caption" />
        <SelectableTextBlock Text="{Binding StatusReason}" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
