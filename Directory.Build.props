<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Version>0.3.7</Version>
    <AssemblyVersion>0.3.7.0</AssemblyVersion>
    <FileVersion>0.3.7.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Avalonia" Version="11.3.11" />
    <PackageReference Update="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Update="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Update="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Update="Avalonia.Diagnostics" Version="11.3.11" />
    <PackageReference Update="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Update="xunit" Version="2.9.2" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Update="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>

